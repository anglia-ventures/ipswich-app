{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ipswich News",
  "version": "0.1.0",
  "identifier": "uk.co.ipswich.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ipswich News",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "News",
    "shortDescription": "Ipswich News for desktop and mobile.",
    "longDescription": "Read the latest from Ipswich News on Mac, Windows, iOS, and Android.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ipswich-app"]
      },
      "mobile": [
        {
          "host": "www.ipswich.co.uk",
          "pathPrefix": ["/auth/callback"]
        }
      ]
    }
  }
}
