# Ghost site URL (no trailing slash). Same site as VITE_GHOST_URL in the app.
GHOST_URL=https://www.ipswich.co.uk

# Admin API key — create a *custom integration* in Ghost Admin under
# Settings → Integrations → Add custom integration, then copy the "Admin API Key".
# Format is "{id}:{hex secret}" — keep this secret, it grants full write access.
GHOST_ADMIN_API_KEY=
