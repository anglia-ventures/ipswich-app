# Ghost site URL (no trailing slash). Same site as VITE_GHOST_URL in the app.
GHOST_URL=https://www.ipswich.co.uk

# Admin API key — create a *custom integration* in Ghost Admin under
# Settings → Integrations → Add custom integration, then copy the "Admin API Key".
# Format is "{id}:{hex secret}" — keep this secret, it grants full write access.
GHOST_ADMIN_API_KEY=

# --- Remote / claude.ai connector mode (optional) ---------------------------
# "stdio" (default) runs as a local process for Claude Desktop / Claude Code.
# "http" runs an HTTP server with a built-in OAuth layer, so it can be added
# as a remote custom connector on claude.ai. Requires the two settings below.
MCP_TRANSPORT=stdio

# This server's externally reachable HTTPS origin, no trailing slash — e.g.
# https://ghost-mcp.yourdomain.com. Put this server behind a reverse proxy
# that terminates TLS; it must match what clients actually connect to.
PUBLIC_URL=

# Shared passphrase shown on the connector's sign-in page. Ghost has no
# per-user login that fits here, so this is the access gate — anyone who
# knows it can connect and draft/edit/delete posts. Use a long random value:
# openssl rand -hex 20
GHOST_MCP_PASSPHRASE=

# Only used in http mode. Local port to listen on (put a reverse proxy in
# front of it for TLS).
PORT=8787

# Only used in http mode. Where OAuth client registrations and refresh
# tokens are persisted across restarts. Defaults to ./oauth-store.json.
OAUTH_STORE_PATH=
