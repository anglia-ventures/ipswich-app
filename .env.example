# Ghost site URL (no trailing slash)
VITE_GHOST_URL=https://www.ipswich.co.uk

# Ghost Content API key — create one in Ghost admin under
# Settings → Integrations → Add custom integration. Use the "Content API key".
# This key is shipped to clients; that's intended.
VITE_GHOST_CONTENT_KEY=

# How many posts to fetch per page on the home feed
VITE_PAGE_SIZE=20
